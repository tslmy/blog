---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { Content as Intro } from '../components/Intro.md';
const posts = (await getCollection('posts', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
---
<Base title="Mingyang Li">
  <header class="home-header">
    <div class="intro"><Intro /></div>
  </header>
  <main class="writing">
    <h2>Writing</h2>
    <ul style="list-style:none;padding:0">
      {posts.map((p) => (
        <li><time>{p.data.date.toISOString().slice(0, 10)}</time> · <a href={`/posts/${p.id}/`}>{p.data.title}</a></li>
      ))}
    </ul>
  </main>
</Base>
