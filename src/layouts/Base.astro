---
import '../styles/global.css';
const { title, description = 'Mingyang Li’s blog' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="alternate" type="application/rss+xml" title="RSS" href="/rss.xml" />
  </head>
  <body>
    <header class="site"><a href="/">Blog</a></header>
    <slot />
    <footer class="site"><a href="/rss.xml">RSS</a></footer>
  </body>
</html>
